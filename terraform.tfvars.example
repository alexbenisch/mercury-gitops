# Azure Subscription
subscription_id = "your-subscription-id-here"

# Resource Group & Location
resource_group_name = "rg-cloud-course-aks"
location            = "North Europe"

# AKS Cluster Configuration
cluster_name       = "mercury-staging"
kubernetes_version = "1.32.0"
node_count         = 2
node_vm_size       = "Standard_D2s_v3"

# Azure Key Vault (must be globally unique)
key_vault_name              = "kv-mercury-staging"
soft_delete_retention_days  = 7
purge_protection_enabled    = false

# Storage Account for CNPG Backups (must be globally unique, 3-24 chars, lowercase/numbers only)
storage_account_name       = "alexmercurybackup"
storage_versioning_enabled = true
sas_token_expiry_hours     = 17520 # 2 years

# Database Configuration
customer1_db_username = "app"

# Cloudflare API Token (for DNS-01 ACME challenges)
cloudflare_api_token = "your-cloudflare-api-token-here"

# Flux CD GitOps
flux_git_repo_url  = "ssh://git@github.com/alexbenisch/mercury-gitops"
flux_git_branch    = "main"
flux_ssh_key_path  = "~/.ssh/mercury"

# Common Tags
tags = {
  Environment = "staging"
  Project     = "mercury"
  ManagedBy   = "terraform"
}
